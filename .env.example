# H.A.D (Hunt Ahlong Down) configuration. Copy to .env or set in your host's settings.
# Never commit real values.

PORT=3000
NODE_ENV=production            # production = Secure cookies (requires HTTPS)

# ---- Database (required) ----
# Supabase: Project > Connect > "Session pooler" connection string (works over IPv4,
# which Render needs). Replace [YOUR-PASSWORD] with the database password.
# Local development: any Postgres 14+, e.g. postgres://postgres@localhost:5432/postgres
DATABASE_URL=
# Tables are created in this schema, never in "public", so Supabase's REST API
# cannot see them. The demo uses "had_demo".
HAD_DB_SCHEMA=had
DATABASE_POOL_MAX=10
# Optional: Supabase's SSL certificate (Project Settings > Database > SSL), to
# verify the server's identity as well as encrypting the connection.
DATABASE_CA_CERT=

# ---- Evidence storage ----
# With both set, evidence goes to a PRIVATE Supabase Storage bucket (created
# automatically; the app refuses to use a public one). Without them, files are
# stored write-once on local disk in HAD_STORAGE_DIR (development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # secret: server only, never in the browser
HAD_STORAGE_BUCKET=evidence
HAD_STORAGE_DIR=./storage      # local files, and temporary upload space

# Public URL, used in password-reset emails (Render sets RENDER_EXTERNAL_URL itself)
HAD_PUBLIC_URL=https://had.example.my

# Session lifetime in hours
HAD_SESSION_HOURS=12

# Email for password reset (optional). Without it, reset links are printed to
# the server log only, which is fine for development but not for production.
SMTP_URL=
MAIL_FROM="H.A.D <no-reply@had.example.my>"

# Demo mode: shows a DEMO banner and uses the "had_demo" schema + local files.
HAD_DEMO_MODE=0

# Map tiles (free OpenStreetMap by default; respect its tile usage policy, or
# switch to a tile provider for heavy traffic)
HAD_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
